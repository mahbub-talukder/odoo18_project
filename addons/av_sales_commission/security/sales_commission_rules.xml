        </record>

        <record id="sales_commission_realtime_report_user_rule" model="ir.rule">
            <field name="name">Sales Commission Realtime Report: User Access</field>
            <field name="model_id" ref="model_sales_commission_realtime_report"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

        <!-- Record Rules for sales.commission.realtime.report.detail: Admin sees all, User sees their own -->
        <record id="sales_commission_realtime_report_detail_admin_rule" model="ir.rule">
            <field name="name">Sales Commission Realtime Report Detail: Admin Access</field>
            <field name="model_id" ref="model_sales_commission_realtime_report_detail"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_admin'))]"/>
        </record>

        <record id="sales_commission_realtime_report_detail_user_rule" model="ir.rule">
            <field name="name">Sales Commission Realtime Report Detail: User Access</field>
            <field name="model_id" ref="model_sales_commission_realtime_report_detail"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

    </data>
</odoo>
