<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SECURITY RULES ENABLED FOR PRODUCTION -->
        <!-- These rules enforce data-level access control -->
        
        <!-- Record Rule for sales.commission: Admin sees all, User sees their own or team's plans -->
        <record id="sales_commission_admin_rule" model="ir.rule">
            <field name="name">Sales Commission: Admin Access</field>
            <field name="model_id" ref="model_sales_commission"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_admin'))]"/>
        </record>

        <record id="sales_commission_user_rule" model="ir.rule">
            <field name="name">Sales Commission: User Access</field>
            <field name="model_id" ref="model_sales_commission"/>
            <field name="domain_force">['|', ('salesperson_ids', 'in', [user.id]), ('team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

        <!-- Record Rule for sales.commission.line: Admin sees all, User sees their own or team's plans -->
        <record id="sales_commission_line_admin_rule" model="ir.rule">
            <field name="name">Sales Commission Line: Admin Access</field>
            <field name="model_id" ref="model_sales_commission_line"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_admin'))]"/>
        </record>

        <record id="sales_commission_line_user_rule" model="ir.rule">
            <field name="name">Sales Commission Line: User Access</field>
            <field name="model_id" ref="model_sales_commission_line"/>
            <field name="domain_force">[('target_id.plan_id.salesperson_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

        <!-- Record Rule for sales.commission.target: Admin sees all, User sees their own or team's plans -->
        <record id="sales_commission_target_admin_rule" model="ir.rule">
            <field name="name">Sales Commission Target: Admin Access</field>
            <field name="model_id" ref="model_sales_commission_target"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_admin'))]"/>
        </record>

        <record id="sales_commission_target_user_rule" model="ir.rule">
            <field name="name">Sales Commission Target: User Access</field>
            <field name="model_id" ref="model_sales_commission_target"/>
            <field name="domain_force">[('plan_id.salesperson_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

        <!-- Record Rule for sales.commission.report: Admin sees all, User sees their own -->
        <record id="sales_commission_report_admin_rule" model="ir.rule">
            <field name="name">Sales Commission Report: Admin Access</field>
            <field name="model_id" ref="model_sales_commission_report"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_admin'))]"/>
        </record>

        <record id="sales_commission_report_user_rule" model="ir.rule">
            <field name="name">Sales Commission Report: User Access</field>
            <field name="model_id" ref="model_sales_commission_report"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('av_sales_commission.group_sales_commission_user'))]"/>
        </record>

        <!-- Record Rules for sales.commission.realtime.report: Admin sees all, User sees their own -->
        <record id="sales_commission_realtime_report_admin_rule" model="ir.rule">
            <field name="name">Sales Commission Realtime Report: Admin Access</field>
            <field name="model_id" ref="model_sales_commission_realtime_report"/>
            <field name="domain_force">[(1,'=',1)]</field>
