<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">commission.plan.form</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <header>
                    <button name="action_approve" string="Approve" type="object" 
                            invisible="state != 'draft'" class="btn-primary" 
                            groups="commission_sales.group_commission_admin"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state not in ('draft', 'approved')" groups="commission_sales.group_commission_admin"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state != 'cancelled'" groups="commission_sales.group_commission_admin"/>
                            
                    <field name="state" widget="statusbar"  decoration-success="state == 'approved'"
                     decoration-warning="state == 'draft'" 
                     decoration-danger="state == 'cancelled'"  
                     invisible="state != 'cancelled'" statusbar_visible="draft,approved,cancelled"/>

                    <field name="state" widget="statusbar" decoration-success="state == 'approved'"
                     decoration-warning="state == 'draft'"  invisible="state == 'cancelled'" 
                     statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'approved' and commission_tracking_ids"/>
                            <field name="target_period_start" readonly="state == 'approved' and commission_tracking_ids"/>
                            <field name="target_period_end" readonly="state == 'approved' and commission_tracking_ids"/>
                            <field name="disbursement_frequency" readonly="state == 'approved' and commission_tracking_ids" help="If you select weekly, then bill will be generated on Monday, if you select biweekly, then bill will be generated on 1st and 15th of month, if you select monthly, then bill will be generated on 1st of month"/>
                            <field name="salesperson_ids" widget="many2many_tags" readonly="state == 'approved' and commission_tracking_ids"/>
                        </group>
                        <group>
                            <field name="first_order_commission" readonly="state == 'approved' and commission_tracking_ids"/>
                            <field name="residual_commission" readonly="state == 'approved' and commission_tracking_ids"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'approved' and commission_tracking_ids"/>
                         
                            <!-- <field name="cron_run_date" widget="string" help="This field is used for testing purpose to run the cron job manually" color="red" /> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Cron Today Date (Testing Purpose)">
                            <field name="cron_run_date" widget="string" help="This field is used for testing purpose to run the cron job manually" color="red" />
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_commission_plan_list" model="ir.ui.view">
        <field name="name">commission.plan.list</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans">
                <field name="name"/>
                <field name="target_period_start" widget="string"/>
                <field name="target_period_end" widget="string"/>
                <field name="disbursement_frequency" widget="selection"/>
                <field name="first_order_commission" widget="number"/>
                <field name="residual_commission" widget="number"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" 
                       decoration-warning="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>
</odoo>