<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sales Commission User (Basic group for all users) -->
        <record id="group_sales_commission_user" model="res.groups">
            <field name="name">Sales Commission User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Sales Commission Administrator (For future use) -->
        <record id="group_sales_commission_admin" model="res.groups">
            <field name="name">Sales Commission Administrator</field>
            <field name="implied_ids" eval="[(4, ref('ox_sales_commission.group_sales_commission_user'))]"/>
        </record>
    </data>
</odoo> 