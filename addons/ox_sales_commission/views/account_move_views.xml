<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_sales_commission" model="ir.ui.view">
            <field name="name">account.move.form.inherit.sales.commission</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_commission_plan" type="object" class="oe_stat_button" icon="fa-briefcase"
                            invisible="not commission_plan_id">
                        <field name="commission_plan_id" string="Commission Plan" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 